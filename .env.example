# OpenAI API Key (Required for live agent conversation and evaluation harness)
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection (e.g. gpt-4o-mini, gpt-4o)
LLM_MODEL=gpt-4o-mini

# Optional: Custom base URL (e.g., OpenRouter, Groq, or local vLLM/Ollama OpenAI-compatible endpoint)
# OPENAI_BASE_URL=https://api.openai.com/v1
